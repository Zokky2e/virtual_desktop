{
	"folders": [
		{
			"name": "virtual_desktop (Flutter frontend)",
			"path": "."
		},
		{
			"name": "virtual-api (FastAPI backend)",
			"path": "../virtual-api"
		}
	],
	"settings": {
		// ---------------------------------------------------------------
		// Java/Gradle tooling is disabled for this workspace.
		//
		// This project is Web + Windows only, but the Red Hat Java
		// extension pack scans every folder for Gradle projects and
		// imports them -- android/, plus ~50 more under the plugin
		// symlink trees in windows/ and linux/ flutter/ephemeral/
		// (firebase_*, file_picker, jni, vlc_player and their
		// example/android projects). Those symlinks are regenerated by
		// `flutter pub get` for the WINDOWS build, so they cannot be
		// deleted -- they have to be excluded here instead.
		//
		// These keys are window-scoped, which means VS Code ignores them
		// in folder-level .vscode/settings.json while a multi-root
		// workspace is open. That is why they live in this file.
		//
		// To re-enable Java tooling: delete this block.
		// ---------------------------------------------------------------
		"java.import.gradle.enabled": false,
		"java.import.maven.enabled": false,
		"java.gradle.buildServer.enabled": "off",
		"java.autobuild.enabled": false,
		"java.import.projectSelection": "manual",
		"java.import.exclusions": [
			"**/node_modules/**",
			"**/.metadata/**",
			"**/archetype-resources/**",
			"**/META-INF/maven/**",
			"**/android/**",
			"**/ios/**",
			"**/build/**",
			"**/flutter/ephemeral/**"
		],
		"gradle.autoDetect": "off",
		"gradle.nestedProjects": false,

		"workbench.colorCustomizations": {
			"activityBar.activeBackground": "#6e2309",
			"activityBar.background": "#6e2309",
			"activityBar.foreground": "#e7e7e7",
			"activityBar.inactiveForeground": "#e7e7e799",
			"activityBarBadge.background": "#0c932f",
			"activityBarBadge.foreground": "#e7e7e7",
			"activityBarTop.activeBackground": "#6e2309",
			"activityBarTop.background": "#6e2309",
			"activityBarTop.foreground": "#e7e7e7",
			"activityBarTop.inactiveForeground": "#e7e7e799",
			"commandCenter.border": "#e7e7e799",
			"commandCenter.foreground": "#e7e7e7",
			"sash.hoverBorder": "#6e2309",
			"statusBar.background": "#3f1405",
			"statusBar.debuggingBackground": "#3f1405",
			"statusBar.debuggingForeground": "#e7e7e7",
			"statusBar.foreground": "#e7e7e7",
			"statusBarItem.hoverBackground": "#6e2309",
			"statusBarItem.remoteBackground": "#097626",
			"statusBarItem.remoteForeground": "#e7e7e7",
			"titleBar.activeBackground": "#3f1405",
			"titleBar.activeForeground": "#e7e7e7",
			"titleBar.inactiveBackground": "#3f140599",
			"titleBar.inactiveForeground": "#e7e7e799"
		},
		"peacock.color": "#3f1405"
	}
}
